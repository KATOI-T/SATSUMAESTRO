# SATSUMAESTRO environment variables. Copy to .env and fill in (never commit .env).
# SATSUMAESTRO の環境変数。.env に写して値を書く（.env はコミットしない）。
#   cp .env.example .env

# ── Model / モデル ──
# Ollama server. /v1 is added when missing. / Ollama の接続先。/v1 は無ければ補う。
OLLAMA_HOST=http://localhost:11434
# Model to use (ollama pull it first). / 使うモデル（先に ollama pull する）。
OLLAMA_MODEL=
# Another OpenAI-compatible server (mlx-lm, vLLM, OpenRouter...). / ほかの OpenAI 互換のサーバ。
OPENAI_BASE_URL=

# ── Cloud API keys (optional) / クラウドの API の鍵（任意） ──
# Without an endpoint above, a key here can send requests to that cloud.
# 上の接続先が無いと、ここの鍵でそのクラウドへ送ることがある。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# ── RAG embeddings / RAG の埋め込み ──
# Needs: ollama pull bge-m3 / 先に ollama pull bge-m3
SATSUMA_EMBED_BASE_URL=http://localhost:11434/v1
SATSUMA_EMBED_MODEL=bge-m3
SATSUMA_EMBED_API_KEY=

# ── Web (off by default) / Web（既定で無効） ──
# web_search: searxng | duckduckgo | generic (searxng and generic need the base URL)
# web_search: searxng | duckduckgo | generic（searxng と generic は base URL が要る）
SATSUMA_WEB_SEARCH_PROVIDER=
SATSUMA_WEB_SEARCH_BASE_URL=
# web_fetch: true to turn it on / true で有効
SATSUMA_WEB_FETCH_ENABLED=

# ── Multi-run (experimental, off by default) / マルチ実行（試験的・既定で無効） ──
# true / false. Decomposition needs orchestration. / decomposition には orchestration も要る。
SATSUMA_ORCHESTRATION=
SATSUMA_DECOMPOSITION=

# Values in the settings files win over this file. / 設定ファイルの値が、このファイルより優先する。
