# 3 段の計画を承認し、段 1 は終えるが、段 2 で read_file を繰り返して max_iterations に当たる。
# 作業ディレクトリの .satsuma/settings.local.json に {"max_iterations": 8} を置いて回す。
# 検査が「宣言 3 段 / 完了 [1]」の不一致と reached max_iterations の失敗行を出すこと。
{"when": {"role": "user", "contains": "三つのファイル"}, "reply": {"tool_calls": [{"name": "write_file", "args": {"path": "{plan_file}", "content": "# 計画\n\n## Steps\n1. a.txt を作る (~5 lines)\n2. b.txt を作る (~5 lines)\n3. c.txt を作る (~5 lines)\n"}}]}, "note": "計画を書く"}
{"when": {"role": "tool", "tool": "write_file", "contains": ".satsuma/plans/"}, "reply": {"tool_calls": [{"name": "exit_plan_mode", "args": {}}]}, "note": "承認を求める"}
{"when": {"role": "tool", "tool": "exit_plan_mode", "contains": "Do ONLY step 1 of 3"}, "reply": {"tool_calls": [{"name": "write_file", "args": {"path": "a.txt", "content": "a\n"}}]}, "note": "段 1"}
{"when": {"role": "tool", "tool": "write_file", "contains": "a.txt"}, "reply": {"text": "段 1 完了: a.txt を作成しました。"}, "note": "段 1 の要約"}
{"when": {"role": "user", "contains": "Now do ONLY step 2 of 3"}, "reply": {"tool_calls": [{"name": "read_file", "args": {"path": "a.txt"}}]}, "note": "段 2: 読むだけ"}
{"when": {"role": "tool", "tool": "read_file"}, "reply": {"tool_calls": [{"name": "read_file", "args": {"path": "a.txt"}}]}, "note": "読み続ける（max_iterations まで）"}
